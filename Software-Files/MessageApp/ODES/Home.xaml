<Controls:MetroWindow x:Class="ODES.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      Title="eSpark"
                      Height="1000"
                      Width="1500"
                      WindowTitleBrush="{x:Null}" MinWidth="1000" MinHeight="600" Icon="Resources/Icon.png"
                      >
    <Controls:MetroWindow.Background >
        <ImageBrush xmlns:properties="clr-namespace:ODES.Properties" ImageSource="{Binding Source={x:Static properties:Settings.Default}, Path=Theme}"/>
    </Controls:MetroWindow.Background>
    <Controls:MetroWindow.WindowButtonCommands>
        <Controls:WindowButtonCommands Template="{DynamicResource MahApps.Metro.Templates.WindowButtonCommands.Win10}" />
    </Controls:MetroWindow.WindowButtonCommands>
    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <ComboBox Name="ThemeSelector"
                      Background="{x:Null}" Controls:TextBoxHelper.Watermark="Change Theme" SelectionChanged="ThemeSelector_SelectionChanged" Foreground="White" >
                <ComboBoxItem Content="Green" Foreground="Black"/>
                <ComboBoxItem Content="Vista" Foreground="Black"/>
                <ComboBoxItem Content="Wooden" Foreground="Black"/>
                <ComboBoxItem Content="Blue" Foreground="Black"/>
            </ComboBox>
            <Button Content="Change Password"/>
            <Button Content="Logout" Name="LogoutBtn" Click="LogoutBtn_Click"/>
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="63*"/>
            <ColumnDefinition Width="1358*"/>
            <ColumnDefinition Width="71*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="41*"/>
            <RowDefinition Height="864*"/>
            <RowDefinition Height="65*"/>
        </Grid.RowDefinitions>
        <TabControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1"  Name="TabContainer" Controls:TabControlHelper.IsUnderlined="True" Controls:TabControlHelper.Underlined="SelectedTabItem" Grid.Column="1" FontSize="15" >
            <TabControl.Background>
                <ImageBrush ImageSource="/Resources/tbbg3.jpg"/>
            </TabControl.Background>
            <Controls:MetroTabItem Header="Main"
                         Controls:ControlsHelper.HeaderFontSize="20" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                <Controls:MetroTabItem.Background>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="270" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" Offset="0.997"/>
                        <GradientStop Color="White"/>
                    </LinearGradientBrush>
                </Controls:MetroTabItem.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="800*"/>
                        <RowDefinition Height="200*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="301*"/>
                        <ColumnDefinition Width="176*"/>
                        <ColumnDefinition Width="199*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox  Header="Messages" Margin="10,10,0,56" Grid.ColumnSpan="2">
                        <Grid x:Name="messagesGrid">
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="50*"/>

                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="20*"/>
                                <RowDefinition Height="20*"/>

                            </Grid.RowDefinitions>
                            <Label Content="Message 01 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" />
                            <RichTextBox FontSize="15"  Margin="111,10,99,10" Controls:TextBoxHelper.Watermark="Message..." TextChanged="RichTextBox_TextChanged" >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_1_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadMsg1_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 02 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Column="2"/>
                            <RichTextBox FontSize="15" Margin="111,10,99,10"  Controls:TextBoxHelper.Watermark="Message..."  Grid.Column="2">
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_2_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Grid.Column="2" Click="uploadMsg2_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>


                            <Label Content="Message 03 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="1" />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="1" Controls:TextBoxHelper.Watermark="Message..."  >
                                <FlowDocument>
                                    <Paragraph>
                                        <Run x:Name="msg_3_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg3" HorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadMsg3_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>


                            <Label Content="Message 04 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="1" Grid.Column="2"/>
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="1" Controls:TextBoxHelper.Watermark="Message..."  Grid.Column="2">
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_4_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg4" HorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Grid.Column="2" Click="uploadMsg4_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 05 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="2" />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="2" Controls:TextBoxHelper.Watermark="Message..."  >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_5_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg5" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadMsg5_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 06 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="2" Grid.Column="2"/>
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="2" Controls:TextBoxHelper.Watermark="Message..." Grid.Column="2" >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_6_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg6" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Grid.Column="2" Click="uploadMsg6_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 07 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="3"  />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="3" Controls:TextBoxHelper.Watermark="Message...">
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_7_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg7" HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadMsg7_Click"  >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 08 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="3" Grid.Column="2" />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="3" Controls:TextBoxHelper.Watermark="Message..." Grid.Column="2" >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_8_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg8" HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84"  Grid.Column="3" Click="uploadMsg8_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 09 :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="4"  />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="4" Controls:TextBoxHelper.Watermark="Message..."  >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_9_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg9" HorizontalAlignment="Right" Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadMsg9_Click"  >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>

                            <Label Content="Message 10:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="4" Grid.Column="2" />
                            <RichTextBox FontSize="15" Margin="111,10,99,10" Grid.Row="4" Controls:TextBoxHelper.Watermark="Message..." Grid.Column="2" >
                                <FlowDocument>
                                    <Paragraph  >
                                        <Run x:Name="msg_10_Txt"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadMsg10" HorizontalAlignment="Right" Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84"  Grid.Column="3" Click="uploadMsg10_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </GroupBox>
                    <Button x:Name="uploadAllBtn" Margin="400,0,400,6" Height="45" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Click="uploadAllBtn_Click" >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="UploadMultiple" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Upload All" />
                        </StackPanel>
                    </Button>
                    <GroupBox Header="Log" Margin="5,10,10,56" Grid.Column="2">
                        <RichTextBox FontSize="15" IsReadOnly="True">
                            <FlowDocument>
                                <Paragraph>
                                    <Run x:Name="MainLogTxt" />
                                </Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                    </GroupBox>
                    <Button x:Name="clearBtn" Margin="5,0,10,6" Height="45" VerticalAlignment="Bottom" Grid.Column="2" Click="clearBtn_Click" >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Eraser" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="Clear Log" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="Configuration"
                         Controls:ControlsHelper.HeaderFontSize="20" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                <Controls:MetroTabItem.Background>
                    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="270" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" Offset="0.997"/>
                        <GradientStop Color="White"/>
                    </LinearGradientBrush>
                </Controls:MetroTabItem.Background>
                <Grid>
                    <GroupBox Header="UART Parameters" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="266" Width="368">
                        <Grid Margin="0,0,0,0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="COM Port" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>

                            <Label Content="Baud Rate" HorizontalAlignment="Left" Margin="10,45,0,0" VerticalAlignment="Top"/>

                            <Label Content="Data Bits" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top"/>
                            <Label Content="Stop Bits" HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top"/>
                            <Label Content="Parity" HorizontalAlignment="Left" Margin="10,150,0,0" VerticalAlignment="Top"/>

                            <Label Content=":" HorizontalAlignment="Left" Margin="7,10,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <Label Content=":" HorizontalAlignment="Left" Margin="10,45,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <Label Content=":" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <Label Content=":" HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <Label Content=":" HorizontalAlignment="Left" Margin="7,150,0,0" VerticalAlignment="Top" Grid.Column="1"/>

                            <TextBox x:Name="selectedComportTxt" Grid.Column="2" Height="23" Margin="10,14,10,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True" />
                            <TextBox Grid.Column="2" Height="23" Margin="10,49,10,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True" Text="115200" />
                            <TextBox Grid.Column="2" Height="23" Margin="10,84,10,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True" Text="8"/>
                            <TextBox Grid.Column="2" Height="23" Margin="10,119,10,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True" Text="1"/>
                            <TextBox Grid.Column="2" Height="23" Margin="10,154,10,0" TextWrapping="Wrap" VerticalAlignment="Top" IsReadOnly="True" Text="None"/>
                            <Button x:Name="reconnectBtn"
                    Width="84" VerticalAlignment="Bottom" Margin="0,0,10,10" HorizontalAlignment="Right" Grid.Column="2" Click="reconnectBtn_Click">
                                <StackPanel
                    Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                    HorizontalAlignment="Center" Kind="SerialPort" VerticalAlignment="Center"/>
                                    <TextBlock
                    Margin="4 0 0 0" Text="Reconnect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Splash Message" HorizontalAlignment="Left" Margin="383,10,0,0" VerticalAlignment="Top" Height="266" Width="510">
                        <Grid>
                            <Label Content="Message :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" />
                            <RichTextBox FontSize="15"  Margin="111,10,99,10" Controls:TextBoxHelper.Watermark="Message..." >
                                <FlowDocument>
                                    <Paragraph>
                                        <Run x:Name="splashMsgTxt" />
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                            <Button x:Name="uploadSplashBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Width="84" Click="uploadSplashBtn_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4 0 0 0"
                    					VerticalAlignment="Center"
                    					Text="Upload" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Controls:MetroTabItem>

        </TabControl>
        <Label Content="" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="White" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,0,19" Height="26" Width="505"/>
        <Label Content="" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="White" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,0,0" Height="26" Width="242"/>
    </Grid>
</Controls:MetroWindow>
