<Controls:MetroWindow x:Class="ODES.LoginForm"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      Title="Login"
                      Height="700"
                      Width="700"
                      WindowTitleBrush="{x:Null}" 
                      PreviewKeyDown="MetroWindow_PreviewKeyDown" MinWidth="650" MinHeight="600" Icon="Resources/Icon.png"
                      >
    <Controls:MetroWindow.Background >
        <ImageBrush xmlns:properties="clr-namespace:ODES.Properties" ImageSource="{Binding Source={x:Static properties:Settings.Default}, Path=Theme}"/>
    </Controls:MetroWindow.Background>
    <Controls:MetroWindow.WindowButtonCommands>
        <Controls:WindowButtonCommands Template="{DynamicResource MahApps.Metro.Templates.WindowButtonCommands.Win10}" />
    </Controls:MetroWindow.WindowButtonCommands>
    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <ComboBox Name="ThemeSelector"
                      Background="{x:Null}" Controls:TextBoxHelper.Watermark="Change Theme" SelectionChanged="ThemeSelector_SelectionChanged" Foreground="White" >
                <ComboBoxItem Content="Green" Foreground="Black"/>
                <ComboBoxItem Content="Vista" Foreground="Black"/>
                <ComboBoxItem Content="Wooden" Foreground="Black"/>
                <ComboBoxItem Content="Blue" Foreground="Black"/>
            </ComboBox>
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="608*"/>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="400" Margin="196,134,196,74">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="203*"/>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="19*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="35*"/>
            </Grid.RowDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="/Resources/LoginScreen.png"/>
            </Grid.Background>
            <Label x:Name="LoginLbl" Content="Login" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" FontFamily="calibri" FontSize="30" Foreground="Gray" Grid.Column="1" Grid.Row="1" Height="46" Width="76" FontWeight="Bold" />
            <DockPanel  HorizontalAlignment="Stretch"  Grid.Row="2"  VerticalAlignment="Top" Grid.Column="1" Height="29">
                <iconPacks:PackIconMaterial Kind="Account" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox x:Name="userIDTxt" Margin="4 0 0 0"
    				VerticalAlignment="Center" Controls:TextBoxHelper.Watermark="User ID" 
    				FontSize="15" BorderThickness="0,0,0,1" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" >
                <iconPacks:PackIconMaterial Kind="Lock" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <PasswordBox x:Name="passTxt" Margin="4 0 0 0" Controls:TextBoxHelper.Watermark="Password" FontSize="15" BorderThickness="0,0,0,1" 
    				VerticalAlignment="Center" 
    				 />
            </DockPanel>
            <Button x:Name="LoginBtn" Grid.Column="1" HorizontalAlignment="Stretch" Grid.Row="4" VerticalAlignment="Top" Click="LoginBtn_Click" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Login" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Margin="4 0 0 0"
                   VerticalAlignment="Center"
                   Text="   LOGIN" />
                    
                </StackPanel>
            </Button>
            <Label Grid.Column="1" HorizontalAlignment="Right" Grid.Row="5" VerticalAlignment="Top" Foreground="Gray" Cursor="Hand" Margin="0,0,0,0" >
                <Underline>Forgot Password?</Underline>
            </Label>
            <Image Grid.Column="1" Margin="10,15,10,10" Source="Resources/logo_noshadow.png"/>
        </Grid>
        <Label Content="" HorizontalAlignment="Left" Margin="10,2,0,0" VerticalAlignment="Top" Foreground="White" Grid.Row="1" Height="26" Width="266"/>
        <Label Content="" HorizontalAlignment="Left" Margin="10,27,0,0" VerticalAlignment="Top" Foreground="White" Grid.Row="1" Height="26" Width="242"/>
    </Grid>
    <!-- your content -->
    

</Controls:MetroWindow>

    